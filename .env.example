# Optional process-level overrides. Normal setup uses `localweave init` and stores
# private configuration outside the repository.

LOCALWEAVE_VAULT_PATH="/absolute/path/to/markdown-vault"
LOCALWEAVE_HOME="/optional/private/localweave-home"
LOCALWEAVE_WHISPER_MODEL="base"
LOCALWEAVE_WHISPER_MODEL_PATH="/absolute/path/to/ggml-base.bin"
